<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#09051D"
                android:endColor="#4B248C" />
        </shape>
    </item>
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#241052" />
            <stroke android:width="2dp" android:color="#B993FF" />
        </shape>
    </item>
    <item android:left="22dp" android:top="45dp" android:right="22dp" android:bottom="35dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#6D3FD0"
                android:centerColor="#B993FF"
                android:endColor="#8B5CF6" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
